<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FabioSoft.Nucleus.Workspaces.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Runtime-form test build: framework + modules come from the runtime Directory.Build.props
       (copied into this Tests project's output); only the local item under test is a ProjectReference. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
    <PackageReference Include="Faqt" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Workspaces.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AccentPaletteTests.fs" />
    <Compile Include="WorkspaceBindingsTests.fs" />
    <Compile Include="WorkspaceUpdateTests.fs" />
    <Compile Include="WorkspaceFileTests.fs" />
    <Compile Include="WorkspaceOverviewRowsTests.fs" />
    <Compile Include="WorkspaceBarRowsTests.fs" />
    <Compile Include="FleetAgentsTests.fs" />
    <Compile Include="SessionPlanTests.fs" />
  </ItemGroup>
</Project>
